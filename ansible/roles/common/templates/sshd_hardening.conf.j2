# {{ ansible_managed }}
# Loaded before the distribution defaults; for most keywords the first value
# sshd reads wins.

Port {{ common_ssh_port }}
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
AuthenticationMethods publickey

AllowUsers {{ ([ansible_user | default('deploy')] + (common_admin_users | map(attribute='name') | list)) | unique | join(' ') }}

MaxAuthTries 3
MaxSessions 10
LoginGraceTime 30
ClientAliveInterval 300
ClientAliveCountMax 2

X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding no
PermitTunnel no
