---
# Generated by Terraform (terraform/main.tf). Do not edit by hand:
# it is overwritten on every `terraform apply`.
all:
  children:
    app:
      hosts:
        ${host_name}:
          ansible_host: ${host_ipv4}
          ansible_user: ${admin_user}
          private_ip: ${private_ip}
  vars:
    deploy_environment: ${environment}
    app_domain: "${app_domain}"
    ssh_allowed_cidrs:
%{ for cidr in ssh_allowed_cidrs ~}
      - "${cidr}"
%{ endfor ~}
