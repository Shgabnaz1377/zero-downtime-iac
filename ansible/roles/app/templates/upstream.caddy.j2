# {{ ansible_managed }}
# Live colour: {{ app_target_color }}
reverse_proxy 127.0.0.1:{{ app_colors[app_target_color] }} {
	# Retry briefly instead of failing a request during a reload.
	lb_try_duration 5s
	lb_try_interval 250ms
	health_uri {{ app_health_path }}
	health_interval 5s
	health_timeout 2s
}
