# Copy to terraform.tfvars and adjust. terraform.tfvars is git-ignored.
#
# Keep the API token out of this file and export it instead:
#   export TF_VAR_hcloud_token="<64-character token from the Hetzner Cloud console>"

name        = "zdi"
environment = "staging"
location    = "fsn1"
server_type = "cx22"

# The contents of your public key file, e.g. ~/.ssh/id_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIReplaceThisWithYourOwnPublicKeyMaterial0000 you@laptop"

# Only these networks may reach port 22. 203.0.113.0/24 is a documentation
# range (RFC 5737): replace it with your own public address.
ssh_allowed_cidrs = ["203.0.113.10/32"]

# Optional: a DNS A/AAAA record pointing at the server enables automatic HTTPS.
app_domain = ""

enable_backups = false
